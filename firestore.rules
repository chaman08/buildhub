rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isParticipant(participants) {
      return signedIn() && participants != null && request.auth.uid in participants;
    }

    function isProjectOwner(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)) &&
        isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.postedBy);
    }

    function isContractorProjectOwner(projectId) {
      return exists(/databases/$(database)/documents/contractor_projects/$(projectId)) &&
        isOwner(get(/databases/$(database)/documents/contractor_projects/$(projectId)).data.postedBy);
    }

    function isAdminUser() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isProjectParticipant(projectId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        (
          get(/databases/$(database)/documents/projects/$(projectId)).data.postedBy == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.acceptedContractorId == request.auth.uid
        );
    }

    function hasSortedParticipants(participants) {
      return participants is list
        && participants.size() == 2
        && participants.all(p, p is string)
        && participants[0] < participants[1];
    }

    function conversationKey(projectId, participants) {
      return (projectId == null || projectId == '' ? 'direct' : projectId) + '__' + participants[0] + '__' + participants[1];
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      // Allow owners to manage their profile; admins can assist with account recovery if needed
      allow create, update: if isOwner(userId) || isAdminUser();
      allow delete: if isAdminUser();
    }

    function validProjectStatus(status) {
      return status in ['draft', 'open', 'awarded', 'closed', 'cancelled'];
    }

    // Public projects
    match /projects/{projectId} {
      // Drafts are private to owner/admin; published projects are public
      allow read: if resource.data.status != 'draft' || isOwner(resource.data.postedBy) || isAdminUser();

      allow create: if signedIn()
        && request.resource.data.postedBy == request.auth.uid
        && validProjectStatus(request.resource.data.status);

      // Updates must keep owner and use allowed status values
      allow update: if signedIn()
        && (!('status' in request.resource.data) || validProjectStatus(request.resource.data.status))
        && (resource.data.postedBy == request.auth.uid || isAdminUser())
        // Lock accepted fields from client-side edits once set
        && (!('acceptedBidId' in request.resource.data) || request.resource.data.acceptedBidId == resource.data.acceptedBidId)
        && (!('acceptedContractorId' in request.resource.data) || request.resource.data.acceptedContractorId == resource.data.acceptedContractorId)
        && (!('acceptedBidAmount' in request.resource.data) || request.resource.data.acceptedBidAmount == resource.data.acceptedBidAmount)
        && (!('acceptedTimeline' in request.resource.data) || request.resource.data.acceptedTimeline == resource.data.acceptedTimeline);

      // Deleting a project only checks ownership
      allow delete: if signedIn() && (resource.data.postedBy == request.auth.uid || isAdminUser());
    }

    // Contractor service projects
    match /contractor_projects/{projectId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.postedBy == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.postedBy == request.auth.uid || isAdminUser());
    }

    // Bids
    match /bids/{bidId} {
      allow create: if signedIn() &&
        request.resource.data.contractorId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        (
          exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId)) ||
          exists(/databases/$(database)/documents/contractor_projects/$(request.resource.data.projectId))
        );

      allow read: if signedIn() && (
        request.auth.uid == resource.data.contractorId ||
        request.auth.uid == resource.data.customerId ||
        isProjectOwner(resource.data.projectId) ||
        isContractorProjectOwner(resource.data.projectId) ||
        isAdminUser()
      );

      // Contractors can edit their own pending/shortlisted bid details (not status/ids)
      allow update: if signedIn()
        && request.auth.uid == resource.data.contractorId
        && resource.data.status in ['pending', 'shortlisted']
        && request.resource.data.status == resource.data.status
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.contractorId == resource.data.contractorId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['message', 'timeline', 'priceQuoted', 'updatedAt']);

      // Project owners can reject/shortlist (acceptance handled server-side)
      allow update: if signedIn()
        && (
          request.auth.uid == resource.data.customerId ||
          isProjectOwner(resource.data.projectId) ||
          isContractorProjectOwner(resource.data.projectId) ||
          isAdminUser()
        )
        && resource.data.status in ['pending', 'shortlisted']
        && request.resource.data.status in ['rejected', 'shortlisted']
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.contractorId == resource.data.contractorId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt', 'rejectedAt', 'shortlistedAt']);

      allow delete: if isAdminUser();
    }

    // Chat threads (one per project + participant pair)
    match /chatThreads/{threadId} {
      function threadParticipantsValid() {
        return hasSortedParticipants(request.resource.data.participants)
          && request.auth.uid in request.resource.data.participants;
      }

      function threadIdValid() {
        return threadId == conversationKey(request.resource.data.projectId, request.resource.data.participants);
      }

      allow create: if signedIn()
        && threadParticipantsValid()
        && threadIdValid();

      allow read: if signedIn() && isParticipant(resource.data.participants);

      allow update: if signedIn()
        && isParticipant(resource.data.participants)
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.projectId == resource.data.projectId
        && threadIdValid()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'lastMessage',
          'lastMessageAt',
          'lastMessageSenderId',
          'lastMessageSenderName',
          'updatedAt'
        ]);

      allow delete: if isAdminUser();
    }

    // Chats (individual messages)
    match /chats/{chatId} {
      function validAttachments() {
        return !('attachments' in request.resource.data) ||
          (request.resource.data.attachments is list
            && request.resource.data.attachments.size() <= 5
            && request.resource.data.attachments.all(att,
              att is string
                && att.size() <= 2048
                && att.matches('^(https://|gs://)')));
      }

      function statusValid(status) {
        return status in ['sent', 'delivered', 'read'];
      }

      function validConversation() {
        return request.resource.data.senderId == request.auth.uid
          && hasSortedParticipants(request.resource.data.participants)
          && request.resource.data.recipientId in request.resource.data.participants
          && request.resource.data.recipientId != request.resource.data.senderId
          && request.resource.data.conversationId == conversationKey(request.resource.data.projectId, request.resource.data.participants)
          && exists(/databases/$(database)/documents/chatThreads/$(request.resource.data.conversationId))
          && get(/databases/$(database)/documents/chatThreads/$(request.resource.data.conversationId)).data.participants == request.resource.data.participants
          && (
            get(/databases/$(database)/documents/chatThreads/$(request.resource.data.conversationId)).data.projectId == request.resource.data.projectId ||
            (!('projectId' in get(/databases/$(database)/documents/chatThreads/$(request.resource.data.conversationId)).data) &&
              (request.resource.data.projectId == null || request.resource.data.projectId == ''))
          );
      }

      function initialReceiptsValid(field) {
        return !(field in request.resource.data) ||
          (request.resource.data[field] is map
            && request.resource.data[field].keys().hasOnly([request.auth.uid])
            && request.resource.data[field][request.auth.uid] is timestamp);
      }

      function receiptUpdateAllowed(field) {
        let current = field in resource.data ? resource.data[field] : {};
        let next = field in request.resource.data ? request.resource.data[field] : current;
        return next is map
          && next.diff(current).addedKeys().hasOnly([request.auth.uid])
          && next.diff(current).changedKeys().hasOnly([request.auth.uid])
          && next.diff(current).removedKeys().size() == 0
          && (!(request.auth.uid in next) || next[request.auth.uid] is timestamp);
      }

      allow create: if signedIn()
        && validConversation()
        && validAttachments()
        && initialReceiptsValid('deliveredTo')
        && initialReceiptsValid('readBy')
        && (!('status' in request.resource.data) || statusValid(request.resource.data.status));

      // Reads: only participants can read
      allow read: if signedIn() && isParticipant(resource.data.participants);

      // Updates: participants can only advance their own delivery/read receipts and status
      allow update: if signedIn()
        && isParticipant(resource.data.participants)
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.message == resource.data.message
        && request.resource.data.attachments == resource.data.attachments
        && request.resource.data.timestamp == resource.data.timestamp
        && request.resource.data.senderName == resource.data.senderName
        && request.resource.data.senderType == resource.data.senderType
        && request.resource.data.recipientName == resource.data.recipientName
        && request.resource.data.recipientType == resource.data.recipientType
        && (!('status' in request.resource.data) || statusValid(request.resource.data.status))
        && receiptUpdateAllowed('deliveredTo')
        && receiptUpdateAllowed('readBy')
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['deliveredTo', 'readBy', 'status', 'read', 'readAt']);

      // Deletes: restrict to admin
      allow delete: if isAdminUser();
    }

    // Notifications
    match /notifications/{notificationId} {
      function validNotificationProject(projectId) {
        return exists(/databases/$(database)/documents/projects/$(projectId)) &&
          (
            get(/databases/$(database)/documents/projects/$(projectId)).data.postedBy == request.auth.uid ||
            get(/databases/$(database)/documents/projects/$(projectId)).data.acceptedContractorId == request.auth.uid
          );
      }

      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && (
          !('projectId' in request.resource.data) ||
          request.resource.data.projectId == null ||
          validNotificationProject(request.resource.data.projectId) ||
          isAdminUser()
        );
      allow read: if signedIn() && request.auth.uid == resource.data.recipientId;
      allow update: if signedIn()
        && request.auth.uid == resource.data.recipientId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isAdminUser();
    }

    // Ratings
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.projectId is string
        && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
        && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.status == 'completed'
        && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.postedBy == request.auth.uid
        && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.acceptedContractorId == request.resource.data.contractorId;
      allow update, delete: if false;
    }

    // Contact messages
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdminUser();
    }

    // KYC requests
    match /kycRequests/{requestId} {
      function validStatus() {
        return request.resource.data.status in ['pending', 'under_review', 'needs_info', 'verified', 'rejected'];
      }

      function validLevel() {
        return request.resource.data.kycLevel == null || request.resource.data.kycLevel in ['basic', 'business'];
      }

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && validLevel();

      allow read: if signedIn() && (isOwner(resource.data.uid) || isAdminUser());

      // Owners can edit while pending/needs_info without self-approving; admins can transition statuses.
      allow update: if signedIn()
        && validStatus()
        && (
          (isOwner(resource.data.uid)
            && (resource.data.status in ['pending', 'needs_info'])
            && request.resource.data.status == resource.data.status
            && request.resource.data.uid == resource.data.uid)
          || isAdminUser()
        );

      allow delete: if isAdminUser();
    }

    // Bookmarks (if used)
    match /bookmarks/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Project progress updates
    match /projectProgress/{updateId} {
      function validProgressStatus() {
        return request.resource.data.status in [
          'not_started',
          'in_progress',
          'awaiting_customer',
          'blocked',
          'at_risk',
          'completed'
        ];
      }

      function validProgressPercent() {
        return request.resource.data.percentComplete is number &&
          request.resource.data.percentComplete >= 0 &&
          request.resource.data.percentComplete <= 100;
      }

      function validProgressPhotos() {
        return !('photos' in request.resource.data) ||
          (request.resource.data.photos is list &&
            request.resource.data.photos.size() <= 10 &&
            request.resource.data.photos.all(photo, photo is string));
      }

      allow create: if signedIn()
        && validProgressStatus()
        && validProgressPercent()
        && validProgressPhotos()
        && request.resource.data.projectId is string
        && request.resource.data.createdBy == request.auth.uid
        && isProjectParticipant(request.resource.data.projectId);

      allow read: if signedIn()
        && (
          isAdminUser() ||
          isProjectParticipant(resource.data.projectId)
        );

      allow update, delete: if false;
    }

    // Project handoff data (milestones, escrow, kickoff)
    match /projectHandoffs/{projectId} {
      function validMilestone(milestone) {
        return milestone is map
          && milestone.id is string
          && milestone.title is string
          && (!('dueDate' in milestone) || milestone.dueDate is string)
          && (!('amount' in milestone) || (milestone.amount is number && milestone.amount >= 0))
          && (!('status' in milestone) || milestone.status in ['proposed', 'agreed', 'done']);
      }

      function validEscrow(escrow) {
        return escrow is map
          && (!('enabled' in escrow) || escrow.enabled is bool)
          && (!('ownerConfirmed' in escrow) || escrow.ownerConfirmed is bool)
          && (!('contractorConfirmed' in escrow) || escrow.contractorConfirmed is bool);
      }

      function validKickoffSide(side) {
        return side is map && side.values().all(v, v is bool);
      }

      function validHandoff() {
        return request.resource.data.projectId == projectId
          && (!('milestones' in request.resource.data) ||
            (request.resource.data.milestones is list
              && request.resource.data.milestones.size() <= 20
              && request.resource.data.milestones.all(m, validMilestone(m))))
          && (!('escrow' in request.resource.data) || validEscrow(request.resource.data.escrow))
          && (!('kickoff' in request.resource.data) ||
            (request.resource.data.kickoff is map
              && (!('owner' in request.resource.data.kickoff) || validKickoffSide(request.resource.data.kickoff.owner))
              && (!('contractor' in request.resource.data.kickoff) || validKickoffSide(request.resource.data.kickoff.contractor))));
      }

      allow create: if signedIn()
        && isProjectParticipant(projectId)
        && validHandoff();
      allow read: if signedIn()
        && (isProjectParticipant(projectId) || isAdminUser());
      allow update: if signedIn()
        && (isProjectParticipant(projectId) || isAdminUser())
        && request.resource.data.projectId == resource.data.projectId
        && validHandoff();
      allow delete: if isAdminUser();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
